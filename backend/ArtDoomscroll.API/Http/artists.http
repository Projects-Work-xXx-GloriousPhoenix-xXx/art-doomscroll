@baseUrl = http://localhost:5256

### ============================================================
### Auth — run first. Access token lives 15 min: re-run on 401.
### ============================================================

### Dev sign-in (Development only)
# @name dev
POST {{baseUrl}}/auth/dev

### ============================================================
### Setup — run first. Safe to re-run: POSTs are find-or-create.
### ============================================================

### Artist B — in my library as Watching
# @name artistB
POST {{baseUrl}}/artists
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "platform": "Pixiv",
  "externalId": "test-artist-B",
  "profileUrl": "https://www.pixiv.net/users/test-artist-B",
  "handle": "artist_b",
  "displayName": "Artist B",
  "status": "Watching"
}

### Work by artist A — A goes to the catalog only, not to my library
# @name workByA
POST {{baseUrl}}/works
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "platform": "Pixiv",
  "externalId": "test-work-001",
  "url": "https://www.pixiv.net/artworks/test-work-001",
  "title": "Test sunset",
  "artist": {
    "externalId": "test-artist-A",
    "profileUrl": "https://www.pixiv.net/users/test-artist-A",
    "handle": "artist_a",
    "displayName": "Artist A"
  }
}

### Work by artist B
POST {{baseUrl}}/works
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "platform": "Pixiv",
  "externalId": "test-work-002",
  "url": "https://www.pixiv.net/artworks/test-work-002",
  "artist": {
    "externalId": "test-artist-B",
    "profileUrl": "https://www.pixiv.net/users/test-artist-B"
  }
}

### ============================================================
### AddArtist
### ============================================================

### Re-add artist B without status — expect 200, status unchanged
POST {{baseUrl}}/artists
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "platform": "Pixiv",
  "externalId": "test-artist-B",
  "profileUrl": "https://www.pixiv.net/users/test-artist-B"
}

### Validation — expect 400 with platform, externalId, profileUrl
POST {{baseUrl}}/artists
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "externalId": " "
}

### ============================================================
### GetArtist
### ============================================================

### Artist B — expect library filled, workCounts.queued: 1
GET {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Artist A — expect library: null (catalog only), workCounts.queued: 1
GET {{baseUrl}}/artists/{{workByA.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Unknown artist — expect 404 "Artist not found"
GET {{baseUrl}}/artists/00000000-0000-0000-0000-00000000dead
Authorization: Bearer {{dev.response.body.$.accessToken}}

### ============================================================
### ListArtists
### ============================================================

### All — expect only artist B (A is catalog-only)
GET {{baseUrl}}/artists
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Search by handle — expect artist B
GET {{baseUrl}}/artists?search=ARTIST_B
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Status — expect empty
GET {{baseUrl}}/artists?status=Queued
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Status + platform — expect artist B
GET {{baseUrl}}/artists?status=Watching&platform=Pixiv
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Paging out of range — expect empty items, totalCount still counted
GET {{baseUrl}}/artists?page=99
Authorization: Bearer {{dev.response.body.$.accessToken}}

### ============================================================
### UpdateArtistStatus
### ============================================================

### Artist B -> Seen — expect newStatus: Seen
PATCH {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}/status
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "status": "Seen"
}

### Artist A (not in my library) — expect 404
PATCH {{baseUrl}}/artists/{{workByA.response.body.$.artistId}}/status
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "status": "Watching"
}

### Missing status — expect 400
PATCH {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}/status
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{}

### ============================================================
### UpdateArtistNote
### ============================================================

### Set note — expect 200 with note
PATCH {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}/note
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "note": "  Great backgrounds, check new works monthly  "
}

### Note is visible on the card — expect library.note (trimmed)
GET {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Clear note with null — expect 200 with note: null
PATCH {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}/note
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "note": null
}

### Clear note with empty string — expect 200 with note: null
PATCH {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}/note
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "note": "   "
}

### Too long (over 1024 chars, built from 56 generated GUIDs) — expect 400 with "note"
PATCH {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}/note
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "note": "{{$randomInt 0 9}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}"
}

### Artist A (catalog-only) — expect 404
PATCH {{baseUrl}}/artists/{{workByA.response.body.$.artistId}}/note
Authorization: Bearer {{dev.response.body.$.accessToken}}
Content-Type: application/json

{
  "note": "x"
}

### ============================================================
### DeleteArtist — run last. Re-run Setup to restore the deleted entry.
### ============================================================

### Delete artist B from my library — expect 204
DELETE {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Artist B still in the catalog — expect 200 with library: null, workCounts unchanged
GET {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Not in my library anymore — expect empty list
GET {{baseUrl}}/artists
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Artist B's works are kept — expect test-work-002
GET {{baseUrl}}/works?artistId={{artistB.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Delete again — expect 404 "not found in your library"
DELETE {{baseUrl}}/artists/{{artistB.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}

### Artist A (catalog-only) — expect 404
DELETE {{baseUrl}}/artists/{{workByA.response.body.$.artistId}}
Authorization: Bearer {{dev.response.body.$.accessToken}}
